// d3d_trace.cpp - native renderer groundwork: which of the game's Xbox 360
// D3D functions (XDK 2.0.2099, no symbols) are called, how often, from where
// and with which arguments. Generated by tools/gen_d3d_trace.py (template
// tools/d3d_trace.cpp.in) from the D3D library's entry points.
//
// Creating build/trace_d3d.txt (contents: frame count, default 1) records
// every call of the next frames to build/d3d_trace.txt: function, return
// address (the call site), r3-r8 and f1-f2. --d3d_call_counts logs calls per
// frame every 300 frames. Otherwise each hook costs one predictable branch.

#include <rex/cvar.h>
#include <rex/hook.h>
#include <rex/logging.h>
#include <rex/memory.h>

#include <atomic>
#include <cstdio>
#include <cstring>
#include <string>

REXCVAR_DEFINE_BOOL(d3d_call_counts, false, "Debug",
                    "Log the game's D3D calls per frame (native renderer groundwork)");

namespace {
constexpr const char* kNames[] = {
@NAMES@
};
constexpr int kCount = int(sizeof(kNames) / sizeof(kNames[0]));
std::atomic<uint64_t> g_counts[kCount];
std::FILE* g_trace = nullptr;
int g_trace_frames = 0;
bool g_active = false;
}  // namespace

// Draw emitters: also the device's shadow of a few context registers
// (device + 11456 holds registers 0x2000..).
static bool IsDrawEmitter(const char* name) {
  return !std::strcmp(name, "sub_825A14B8") || !std::strcmp(name, "sub_825A1278") ||
         !std::strcmp(name, "sub_825A0B60") || !std::strcmp(name, "sub_825A0E88");
}

static uint32_t ShadowRegister(uint8_t* base, uint32_t device, uint32_t index) {
  uint32_t offset = 11456 + (index - 0x2000) * 4;
  return rex::byte_swap(*reinterpret_cast<uint32_t*>(base + device + offset));
}

static void Amped3D3DTrace(int id, PPCContext& ctx, uint8_t* base) {
  if (!g_active) {
    return;
  }
  g_counts[id].fetch_add(1, std::memory_order_relaxed);
  if (g_trace) {
    std::fprintf(g_trace,
                 "%s lr=%08X r3=%08X r4=%08X r5=%08X r6=%08X r7=%08X r8=%08X f1=%g f2=%g\n",
                 kNames[id], uint32_t(ctx.lr), ctx.r3.u32, ctx.r4.u32, ctx.r5.u32, ctx.r6.u32,
                 ctx.r7.u32, ctx.r8.u32, ctx.f1.f64, ctx.f2.f64);
    if (IsDrawEmitter(kNames[id])) {
      uint32_t device = ctx.r3.u32;
      std::fprintf(g_trace, "  shadow surface %08X color0 %08X depth %08X window offset %08X scissor %08X %08X\n",
                   ShadowRegister(base, device, 0x2000), ShadowRegister(base, device, 0x2001),
                   ShadowRegister(base, device, 0x2002), ShadowRegister(base, device, 0x2080),
                   ShadowRegister(base, device, 0x2081), ShadowRegister(base, device, 0x2082));
    }
  }
}

// Called once per frame (frame_stats.cpp, at the game's VdSwap call).
void Amped3_D3DTraceFrame() {
  static uint32_t frames = 0;
  std::FILE* trigger_file = nullptr;
  if (g_trace) {
    std::fputs("FRAME\n", g_trace);
    if (--g_trace_frames <= 0) {
      std::fclose(g_trace);
      g_trace = nullptr;
    }
  } else if (++frames % 60 == 0 && (trigger_file = std::fopen("trace_d3d.txt", "r"))) {
    std::FILE* trigger = trigger_file;
    if (std::fscanf(trigger, "%d", &g_trace_frames) != 1) {
      g_trace_frames = 1;
    }
    std::fclose(trigger);
    std::remove("trace_d3d.txt");
    g_trace = std::fopen("d3d_trace.txt", "w");
  }
  g_active = REXCVAR_GET(d3d_call_counts) || g_trace;
  if (REXCVAR_GET(d3d_call_counts) && frames % 300 == 0) {
    std::string line;
    for (int i = 0; i < kCount; ++i) {
      uint64_t n = g_counts[i].exchange(0, std::memory_order_relaxed);
      if (n) {
        line += fmt::format(" {}:{}", kNames[i] + 4, n / 300);
      }
    }
    REXLOG_INFO("d3d_call_counts per frame:{}", line);
  }
}

@HOOKS@
